# Database Configuration
# Leave empty for local SQLite development (pahadily.db).
# For production, use your PostgreSQL connection string.
DATABASE_URL=

# Comma-separated frontend URLs allowed to call the API.
FRONTEND_URLS=https://YOUR-FRONTEND.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Email & Notification Delivery Configuration
# Leave empty for live terminal console visualization.
# For live real-world email delivery (e.g. Gmail App Password, Brevo, SendGrid, Amazon SES):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pahadíly Himalayan Journeys <noreply@pahadily.com>
SENDER_NAME=Pahadíly Himalayan Journeys
